# Font
font_size 15
font_family          Maple Mono NF CN Regular
bold_font            Maple Mono NF CN Bold
italic_font          Maple Mono NF CN Italic
bold_italic_font     Maple Mono NF CN Bold Italic
font_features        MapleMono-NF-CN-Regular +calt +cv01 +cv65 +ss02
font_features        MapleMono-NF-CN-Bold +calt +cv01 +cv65 +ss02
font_features        MapleMono-NF-CN-Italic +calt +cv01 +cv65 +ss02
font_features        MapleMono-NF-CN-BoldItalic +calt +cv01 +cv65 +ss02
# -> != >=
disable_ligatures cursor

# Window
hide_window_decorations        titlebar-only
window_padding_width           12
remember_window_size           yes

# Tab bar
tab_bar_edge                top
tab_bar_style               powerline
tab_powerline_style         slanted

# General key mapping
macos_option_as_alt yes

# Animation
enable_audio_bell no
cursor_trail 3
cursor_trail_decay 0.1 0.4
cursor_blink_interval 0

# Theme switching
map ctrl+cmd+shift+l kitten themes --reload-in=all Catppuccin Kitty Latte
map ctrl+cmd+shift+m kitten themes --reload-in=all Catppuccin Kitty Mocha

# Change Editor
editor nvim

# Use Fish Shell
shell /opt/homebrew/bin/fish


# BEGIN_KITTY_THEME
# Catppuccin Kitty Mocha
include current-theme.conf
# END_KITTY_THEME
