{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/Developer/ascii_art.txt"
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "yellow",
      "title": "red"
    },
    "key": {
      "width": 4,
      "type": "icon"
    },
    "bar": {
      "width": 10
    },
    "size": {
      "maxPrefix": "MB",
      "ndigits": 0,
      "spaceBeforeUnit": "never"
    },
    "freq": {
      "ndigits": 3,
      "spaceBeforeUnit": "never"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    {
      "type": "kernel",
      "format": "{release}"
    },
    "uptime",
    {
      "type": "packages",
      "combined": true
    },
    "shell",
    "terminal",
    {
      "type": "terminalfont",
      "format": "{/name}{-}{/}{name}{?size} {size}{?}"
    },
    "cpu",
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}"
    },
    {
      "type": "battery",
      "key": "battery",
      "percent": {
        "type": 3,
        "green": 20,
        "yellow": 40
      }
    },
    "break"
  ]
}
