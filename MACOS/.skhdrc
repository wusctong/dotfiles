ctrl + cmd - l : yabai --restart-service

ctrl + cmd - w : yabai -m window --focus north
ctrl + cmd - s : yabai -m window --focus south
ctrl + cmd - a : yabai -m window --focus west
ctrl + cmd - d : yabai -m window --focus east

ctrl + alt - w : yabai -m window --swap north
ctrl + alt - s : yabai -m window --swap south
ctrl + alt - a : yabai -m window --swap west
ctrl + alt - d : yabai -m window --swap east
