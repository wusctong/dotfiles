{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ",
    "key": {
      "width": 4,
      "type": "icon"
    }
  },
  "logo": {
      "type": "small"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "shell",
    "terminal",
    {
      "type": "memory",
      "format": "{used} / {total}"
    }
  ]
}
